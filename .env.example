# Public Supabase project connection values. Safe for browser use only with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ or import them in client modules.
SUPABASE_SERVICE_ROLE_KEY=
APP_INVITE_PEPPER=

# Canonical public application URL, including protocol.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" only for local Playwright E2E runs (playwright.config.ts sets
# this automatically for its managed dev server). Enables POST /api/test/session,
# a Google-OAuth bypass that signs a browser session in directly from a
# Supabase access/refresh token pair. Never set this in a deployed environment;
# the route also hard-refuses when NODE_ENV=="production" regardless of this flag.
E2E_TEST_MODE=
